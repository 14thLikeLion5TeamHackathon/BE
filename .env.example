# 서버(EC2)에 .env 파일로 저장해서 사용. 이 파일 자체는 예시일 뿐 git에는 실제 값 커밋하지 않음.
DB_PASSWORD=change-me
JWT_SECRET=change-this-secret-key-please-make-it-at-least-32-bytes-long
KAKAO_CLIENT_ID=
KAKAO_CLIENT_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
OPENWEATHER_API_KEY=
OPENAI_API_KEY=
FRONTEND_REDIRECT_URI=http://localhost:3000
FRONTEND_FAILURE_REDIRECT_URI=http://localhost:3000/login?error=oauth2_failure
